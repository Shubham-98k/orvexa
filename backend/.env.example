PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/orvexa
JWT_SECRET=orvexa_dev_jwt_secret_key_change_in_production_8932478
JWT_EXPIRES_IN=7d

# Guest Preview & Rate Limiting
GUEST_PREVIEW_SECONDS=120
PUBLIC_API_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_API_RATE_LIMIT_MAX_REQUESTS=60
PUBLIC_SEARCH_RATE_LIMIT_MAX_REQUESTS=20

# Optional override: set false to hide the table in development; enable only for isolated test deployments.
DEMO_ACCOUNTS_ENABLED=
# Must match the password used when seeded users were created. Defaults to the seed password in development/test.
DEMO_ACCOUNT_PASSWORD=

# Optional Knowledge Studio AI (Gemini is server-side only; disabled by default).
AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_USER_MONTHLY_LIMIT=20
AI_MONTHLY_REQUEST_LIMIT=1000
AI_MONTHLY_BUDGET_INR=500
AI_RATE_LIMIT_PER_MINUTE=10
# Set both rates to enable estimated-cost budget enforcement. Rates are INR per 1M tokens.
AI_INPUT_RATE_INR_PER_MILLION=
AI_OUTPUT_RATE_INR_PER_MILLION=
