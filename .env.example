# Orvexa Environment Configuration Example

# Server Environment
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/orvexa

# Authentication & Session Security
SESSION_SECRET=your_super_secret_session_key_change_in_production
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Storage Adapter (Local / S3-compatible)
STORAGE_PROVIDER=local
STORAGE_BUCKET=orvexa-uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# AI Provider (Gemini / AI Adapter for Knowledge writing partner)
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Email Provider Adapter (Verification & Password reset)
EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@orvexa.com
